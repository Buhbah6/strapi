{
  "kind": "collectionType",
  "collectionName": "categories",
  "info": {
    "singularName": "category",
    "pluralName": "categories",
    "displayName": "Category"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "article",
        "tutorial",
        "video"
      ]
    },
    "description": {
      "type": "text",
      "required": false
    },
    "color": {
      "type": "string"
    }
  }
}
